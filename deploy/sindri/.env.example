# Required. Set to ghcr.io/gonecrzy/pulse:<full 40-character source SHA>
# or ghcr.io/gonecrzy/pulse@sha256:<64-character image digest>.
PULSE_IMAGE=

# Isolated by default: this creates its own container namespace and data volume.
COMPOSE_PROJECT_NAME=pulse-sindri-test

# Bind locally by default. Set 0.0.0.0 only when remote access is intended.
PULSE_BIND_ADDRESS=127.0.0.1
PULSE_PORT=17655
TZ=UTC
